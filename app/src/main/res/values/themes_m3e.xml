<?xml version="1.0" encoding="utf-8"?>
<!--
  M3E experiment layer (debug3 branch only).
  Source: every difference between material 1.14.0 Base.Theme.Material3Expressive.Light
  and Base.Theme.Material3.Light: component styles / sizes / motion springs (44 items).
  Two categories are deliberately excluded, so this layer stays a pure shape+motion layer
  and does not fight the color system:
    1. colorOn*Container (4 items): the 20 accent palettes come from the
       materialThemeBuilder-generated ThemeOverlay.*.Material* resources.
    2. dynamicColorThemeOverlay: only the M3E base themes set it, and they set it per
       configuration (Light -> ThemeOverlay.Material3Expressive.DynamicColors.Light,
       Dark -> ...DynamicColors.Dark). This file only lives in values/, so defining it here
       would force the Light overlay in night mode. It also re-declares the fixed palette
       colorOn*Container roles that DynamicColors is supposed to compute, so the app's
       current dynamic-color path (rikka + ThemeUtils) is left untouched.
  Rollback: delete this file and drop the parent on Platform.Theme.C001apk in themes.xml.
-->
<resources>

    <style name="Theme.C001apk.M3E" parent="Theme.Material3.DynamicColors.DayNight.Rikka">
        <item name="alertDialogTheme">@style/ThemeOverlay.Material3Expressive.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Material3Expressive.MaterialAlertDialog</item>
