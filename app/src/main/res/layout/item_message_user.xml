<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <import type="com.example.c001apk.util.DateUtils" />

        <import type="com.example.c001apk.util.MessageKit" />

        <variable
            name="type"
            type="String" />

        <variable
            name="data"
            type="com.example.c001apk.logic.model.MessageResponse.Data" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{(view) -> listener.onViewUser(view, MessageKit.partnerUid(data))}"
        app:cardBackgroundColor="@color/home_card_background_color"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/cover"
                android:foreground="@drawable/selector_bg_avatar"
                app:layout_constraintDimensionRatio="H, 1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:setImage="@{type == `list` ? MessageKit.partnerAvatar(data) : data.fromUserAvatar}"
                app:shapeAppearance="@style/circleImageStyle" />

            <!--
                私信会话（type=list）要展示的是**对方**：messageUsername / messageUserAvatar。
                直接拿 username / userAvatar 可能显示成我自己（最后一条消息是我发的时）。
            -->
            <TextView
                android:id="@+id/uname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{type == `list` ? MessageKit.partnerName(data) : data.fromusername}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:text="@{String.valueOf(DateUtils.fromToday(data.dateline))}"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toBottomOf="@id/uname" />

            <TextView
                android:id="@+id/fans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:text="@{type == `contactsFollow` ? `关注了你` : ``}"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                android:visibility="@{type == `contactsFollow` ? View.VISIBLE : View.GONE}"
                app:layout_constraintStart_toEndOf="@id/follow"
                app:layout_constraintTop_toBottomOf="@id/uname" />

            <!--
                第二行：私信会话显示「最后一条消息」预览。
                fans 在 list 下是 GONE，所以这一条会紧贴在时间右侧，占满剩余宽度。
            -->
            <TextView
                android:id="@+id/act"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{type == `list` ? MessageKit.preview(data) : ``}"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/fans"
                app:layout_constraintTop_toBottomOf="@id/uname" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>