<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="refreshListener"
            type="com.example.c001apk.ui.feed.reply.reply2reply.ReplyRefreshListener" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

        <import type="com.example.c001apk.util.DateUtils" />

        <import type="android.view.View" />

        <variable
            name="username"
            type="String" />

        <variable
            name="avatarUrl"
            type="String" />

        <variable
            name="dateline"
            type="Long" />

        <variable
            name="deviceTitle"
            type="String" />

        <!-- 顶栏作者行的认证角标：变量名避开 app:verify* 属性名，免得跟 BindingAdapter 撞 -->
        <variable
            name="authorUid"
            type="String" />

        <variable
            name="authorVerifyIcon"
            type="String" />

        <variable
            name="authorVerifyStatus"
            type="Integer" />

    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:consumeSystemWindowsInsets="@integer/internal_fragment_insets"
        app:edgeToEdge="true"
        app:fitsSystemWindowsInsets="@integer/internal_fragment_insets"
        tools:context=".ui.feed.FeedFragment">

        <FrameLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    app:fitsSystemWindowsInsets="bottom" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <LinearLayout
                android:id="@+id/tabLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:windowBackground"
                android:orientation="vertical"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/replyCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toTopOf="@id/divider"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="共 99 回复" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/buttonToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="15dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:checkedButton="@id/lastUpdate"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/divider"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/lastUpdate"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:onClick="@{() -> refreshListener.onRefreshReply(`lastupdate_desc`)}"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="默认"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/dateLine"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:onClick="@{() -> refreshListener.onRefreshReply(`dateline_desc`)}"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="最新"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/popular"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:onClick="@{() -> refreshListener.onRefreshReply(`popular`)}"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="热门"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/author"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:onClick="@{() -> refreshListener.onRefreshReply(``)}"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:text="楼主"
                            android:textSize="12sp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>

                <View
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="?attr/colorSurfaceVariant" />

            </LinearLayout>

        </FrameLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_reply"
            android:tooltipText="@string/reply"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <include
            android:id="@+id/indicator"
            layout="@layout/item_indicator" />

        <include
            android:id="@+id/errorMessage"
            layout="@layout/item_error_message" />

        <include
            android:id="@+id/errorLayout"
            layout="@layout/item_error_layout" />

        <!-- 顶栏排在列表后面：CoordinatorLayout 按子 View 顺序绘制，appBar 写在 contentLayout
             之前时，作者行滑出顶栏下边界的那半截会被列表整个盖掉（bringChildToFront 只在运行时
             管用，这里按静态顺序钉死）。顶栏本身透明、不裁子 View，排在后面不会挡住列表内容。 -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:clipChildren="false"
            android:fitsSystemWindows="false"
            app:fitsSystemWindowsInsets="@integer/internal_fragment_top_insets">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolBar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:clipChildren="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/titleProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatar"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@color/cover"
                        android:foreground="@drawable/selector_bg_avatar"
                        android:onClick="@{(view) -> listener.onViewUser(view, username)}"
                        app:layout_constraintBottom_toBottomOf="@id/date"
                        app:layout_constraintDimensionRatio="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:setImage="@{avatarUrl}"
                        app:shapeAppearance="@style/circleImageStyle" />

                    <!-- 认证角标：压在头像右下角，没认证时 GONE -->
                    <ImageView
                        android:id="@+id/verifyBadge"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:background="@drawable/bg_verify_badge"
                        android:contentDescription="@null"
                        android:padding="2dp"
                        android:src="@drawable/ic_verify_check"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/avatar"
                        app:layout_constraintEnd_toEndOf="@id/avatar"
                        app:verifyIcon="@{authorVerifyIcon}"
                        app:verifyStatus="@{authorVerifyStatus}"
                        app:verifyUid="@{authorUid}" />

                    <TextView
                        android:id="@+id/name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{username}"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/avatar"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="name" />

                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:maxLines="1"
                        android:text="@{String.valueOf(DateUtils.fromToday(dateline))}"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="13sp"
                        app:layout_constraintStart_toEndOf="@id/avatar"
                        app:layout_constraintTop_toBottomOf="@id/name"
                        tools:text="date" />

                    <TextView
                        android:id="@+id/device"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="13sp"
                        android:visibility="@{deviceTitle == null || deviceTitle.isEmpty ? View.INVISIBLE : View.VISIBLE}"
                        app:customText="@{deviceTitle}"
                        app:icon="@{@drawable/ic_device}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/date"
                        app:layout_constraintTop_toBottomOf="@id/name"
                        tools:text="device" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.appbar.MaterialToolbar>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="?attr/colorSurfaceVariant" />

        </com.google.android.material.appbar.AppBarLayout>

        <!-- 作者行要能整块滑到顶栏下边去，所以顶栏那一支设了 clipChildren=false，
             标题滑出顶栏的那一截就没人裁了 —— 用这块跟"顶栏上方空白"等高的底片把它压住。
             顶栏上方本来没有空白时它是 0 高，等于没有。 -->
        <View
            android:id="@+id/topMask"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?android:windowBackground"
            android:clickable="false"
            android:focusable="false" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</layout>