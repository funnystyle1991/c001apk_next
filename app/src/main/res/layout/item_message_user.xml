<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="android.view.View" />

        <import type="com.example.c001apk.util.DateUtils" />

        <import type="com.example.c001apk.util.MessageKit" />

        <variable
            name="type"
            type="String" />

        <variable
            name="data"
            type="com.example.c001apk.logic.model.MessageResponse.Data" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClick="@{(view) -> listener.onViewUser(view, MessageKit.partnerUid(data))}"
        app:cardBackgroundColor="@color/home_card_background_color"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/avatar"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@color/cover"
                android:foreground="@drawable/selector_bg_avatar"
                app:layout_constraintDimensionRatio="H, 1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:setImage="@{MessageKit.partnerAvatar(data)}"
                app:shapeAppearance="@style/circleImageStyle" />

            <!--
                认证角标：压在头像右下角，没认证时 GONE。
                uid 认 partnerUid（跟头像、点击跳转同一个来源，永远指向「对方」）；
                认证字段由 MessageKit.verifyIcon / verifyStatus 从 fromUserInfo 里取 ——
                私信会话（/v6/message/list）没有那个对象，这一支就只按 uid 查云端认证表。
            -->
            <ImageView
                android:id="@+id/verifyBadge"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/bg_verify_badge"
                android:contentDescription="@null"
                android:padding="2dp"
                android:src="@drawable/ic_verify_check"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/avatar"
                app:layout_constraintEnd_toEndOf="@id/avatar"
                app:verifyIcon="@{MessageKit.verifyIcon(data)}"
                app:verifyStatus="@{MessageKit.verifyStatus(data)}"
                app:verifyUid="@{MessageKit.partnerUid(data)}" />

            <!--
                要展示的是**对方**：私信会话认 messageUsername / messageUserAvatar，
                通知条目（好友关注）认 fromusername / fromUserAvatar——
                partnerName / partnerAvatar 内部已经按这个顺序兜底了。
                直接拿 username / userAvatar 会显示成我自己（最后一条消息是我发的时）。
            -->
            <TextView
                android:id="@+id/uname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{MessageKit.partnerName(data)}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/follow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:text="@{String.valueOf(DateUtils.fromToday(data.dateline))}"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/avatar"
                app:layout_constraintTop_toBottomOf="@id/uname" />

            <TextView
                android:id="@+id/fans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:text="@{MessageKit.isContactsFollow(type) ? `关注了你` : ``}"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                android:visibility="@{MessageKit.isContactsFollow(type) ? View.VISIBLE : View.GONE}"
                app:layout_constraintStart_toEndOf="@id/follow"
                app:layout_constraintTop_toBottomOf="@id/uname" />

            <!--
                第二行：私信会话显示「最后一条消息」预览。
                fans 在 list 下是 GONE，所以这一条会紧贴在时间右侧，占满剩余宽度。
            -->
            <TextView
                android:id="@+id/act"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{MessageKit.isList(type) ? MessageKit.preview(data) : ``}"
                android:textColor="@android:color/darker_gray"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/fans"
                app:layout_constraintTop_toBottomOf="@id/uname" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>