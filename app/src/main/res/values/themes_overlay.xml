<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="ThemeOverlay" />

  <style name="ThemeOverlay.Black">
    <item name="colorSurface">@android:color/black</item>
    <item name="android:colorBackground">@android:color/black</item>
    <!--
      卡片与顶栏现在取 colorSurfaceContainer（见 color/home_card_background_color.xml 与
      Theme.C001apk 的 toolbarStyle）。M3 的 container 色阶是固定色值，不会跟着
      colorSurface 变黑，纯黑主题下会泛出灰紫，所以这里把容器档压回近黑。
      留一点点灰差（#0A0A0A~#212121）是为了纯黑下仍能看出卡片边界。
    -->
    <item name="colorSurfaceContainerLowest">@android:color/black</item>
    <item name="colorSurfaceContainerLow">#0A0A0A</item>
    <item name="colorSurfaceContainer">#121212</item>
    <item name="colorSurfaceContainerHigh">#1A1A1A</item>
    <item name="colorSurfaceContainerHighest">#212121</item>
  </style>
</resources>
