<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="data"
            type="com.example.c001apk.logic.model.HomeFeedResponse.Entities" />

        <variable
            name="listener"
            type="com.example.c001apk.adapter.ItemListener" />

    </data>

    <!-- 最新点评一条：左边是点评正文，右边是该条点评对应的游戏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/round_corners_12_win"
        android:foreground="@drawable/selector_bg_12_trans"
        android:onClick="@{(view) -> listener.onViewFeed(view, data.id, null, data.username, null, null, data.message, null, null, null, null)}"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{data.username}"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                tools:text="Kiming同学" />

            <TextView
                android:id="@+id/message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:lineSpacingMultiplier="1.2"
                android:text="@{data.message}"
                android:textSize="14sp"
                tools:text="【点评】画质牛批，没了" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@color/cover"
                app:setImage="@{data.tpic}"
                app:shapeAppearance="@style/searchTopicRadius"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="@{data.ttitle}"
                android:textSize="11sp"
                tools:text="我的世界" />

        </LinearLayout>

    </LinearLayout>

</layout>
