<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:orientation="horizontal" />

    <com.example.liquidglass.LiquidGlassView
        android:id="@+id/navGlass"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:backdropSourceId="@id/viewPager"
        app:cornerRadius="999dp"
        app:glassMaterial="clear"
        app:layout_anchor="@id/viewPager"
        app:layout_anchorGravity="bottom">

        <!-- 高度必须 0dp：在 wrap_content 父容器里 match_parent 会参与测量把玻璃罩撑满全屏 -->
        <com.example.c001apk.view.LiquidIndicatorView
            android:id="@+id/navIndicator"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            app:itemActiveIndicatorStyle="@style/NavNoActiveIndicator"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/nav_menu" />

    </com.example.liquidglass.LiquidGlassView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>