<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <!-- 头像 + 认证角标：手动 inflate 的 ViewHolder，角标在代码里用 VerifyBadge.applyTo 设 -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cover"
            app:shapeAppearance="@style/circleImageStyle" />

        <ImageView
            android:id="@+id/verifyBadge"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_verify_badge"
            android:contentDescription="@null"
            android:padding="2dp"
            android:src="@drawable/ic_verify_check"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp"
            tools:text="mlgmxyysd" />

        <TextView
            android:id="@+id/uid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            tools:text="UID: 814297" />

    </LinearLayout>

    <ImageView
        android:id="@+id/remove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/actionBarItemBackground"
        android:padding="10dp"
        android:src="@drawable/ic_close"
        tools:ignore="ContentDescription" />

</LinearLayout>
